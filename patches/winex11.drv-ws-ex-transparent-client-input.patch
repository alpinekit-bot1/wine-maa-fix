+        rect.y = data->rects.client.top - data->rects.visible.top;
+        rect.width = data->rects.client.right - data->rects.client.left;
+        rect.height = data->rects.client.bottom - data->rects.client.top;
         XShapeCombineRectangles( data->display, data->whole_window, ShapeInput, 0, 0,
