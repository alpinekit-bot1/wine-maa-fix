     return (CWSaveUnder | CWColormap | CWBorderPixel | CWBackPixel |
             CWEventMask | CWBitGravity | CWBackingStore);
@@ -548,17 +547,20 @@ static void sync_window_input_shape( struct x11drv_win_data *data )
 
     if (ex_style & WS_EX_TRANSPARENT)
     {
-        /* For transparent windows, set an empty input shape to allow mouse pass-through */
-        static XRectangle empty_rect;
+        /* For transparent windows, keep the client area interactive and only let
